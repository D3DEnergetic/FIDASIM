    tmin  = 1.0e3                   ! [eV]
    tmax  = 19.0e3                  ! [eV]
    nt    = 10

    emin  = 5.0e3                   ! [eV/amu]
    emax  = 1.0e5                   ! [eV/amu]
    neb   = 5
    beam_mass = 1.0                 ! [amu]
/
