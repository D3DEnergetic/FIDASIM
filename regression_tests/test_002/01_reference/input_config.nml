&input
  input_file_type = 'fidasim_h5'
  input_filename = '/home/jfcm/Documents/compX/IPS_runs/cql3d_fidasim_run_2d/work/nbi__fidasim_4/WHAM_001_distribution.h5'
  
  species = 'D'
  atomic_number = 1
  mass_number = 2
  charge_state = 1
  
  r_locations = 0,  0,  0, 0
  z_locations = 0, 20, 40, 60
  
  plot_data = .true.
  save_data = .true.
/

&plot_data_block
  scale = 'lin'
  fmin = 0.2e17
  fmax = 1e17
  enable_colorbar = .true.
  colormap = 'hot_r'
/

&save_data_block
  output_filename = 'output_data/f_array.h5'
/
