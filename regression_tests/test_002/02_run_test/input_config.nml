&input
  reference_config = '../01_reference/input_config.nml'
  nenergy = 120
  npitch = 60
  plot_data = .true.
/

&save_data_block
  output_filename = 'output_data/fidasim_f4d.h5'
/

&plot_data_block
  scale = 'lin'
  fmin = 'auto'
  fmax = 'auto'
  enable_colorbar = .true.
  colormap = 'hot_r'
  contour_levels = 30
  emax = 150
/
