&run_test
  comment = 'Dataset A: 60 keV neutral beam at 45 degrees'
  input_distribution_config = '../../test_002/02_run_test/input_config_A.nml'
  output_directory = 'output_data/dataset_A'
  n_samples = 1000000
  seed = 12345
  plot_data = .true.
/

&plot_data_block
  scale = 'lin'
  fmin = 'auto'
  fmax = 'auto'
  enable_colorbar = .true.
  colormap = 'hot_r'
  emax = 150.0
/
